# Signal secrets. Copy to .env (git-ignored) and fill in what you use.

# Cloud model providers (only needed if you switch a job away from Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Notification targets as Apprise URLs, separated by commas or spaces.
# ntfy (no account needed; pick a long random topic name):  ntfy://my-signal-topic-x7k2
# Discord webhook (Server Settings > Integrations > Webhooks > Copy URL):
#   https://discord.com/api/webhooks/123/abc  ->  discord://123/abc
APPRISE_URLS=

# Required only if web.host is not 127.0.0.1 (e.g. 0.0.0.0 to reach Signal from your phone)
SIGNAL_WEB_PASSWORD=
